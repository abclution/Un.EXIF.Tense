#_EZ_PRE_="$(echo -e "$_VERBOSE_\n$_SUPRESSMINERR_\n$_PRESERVE_\n$_EXTLIST_\n$_NOXMP_\n$_GETTAGSFROMCURRENTFILE_\n$_WRITEOVERFILE_")"
$_ZZEZ_PRE_

-api
ImageHashType=SHA512
-filename <${ImageDataHash}.%e$_COUNTER_

