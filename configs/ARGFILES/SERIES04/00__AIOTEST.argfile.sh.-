#!/bin/bash
# shellcheck disable=all
# exiftool argfile
#~ 🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾
#* MISC NOTES
#! CONSIDERED ORDER OF OPERATIONS

#* 	-	MEDIA - MOVES FILES MISSING EXIF METADATA TO SEPERATE LOCATION
#*	-	XMP - RENAMES-EXISTING-SIDECARS-TO-CURRENT-SCHEME(filename.ext.xmp)
#* 	-	XMP - UPDATES OR CREATES SIDECAR, FILLS ANY MISSING TAGS & XMP-xmpMM:PreservedFileName & XMP-getty:OriginalFilename
#*	-	XMP & MEDIA - RENAME AND MOVE FILES TO STANDARD NAMING SCHEME
#*	-
#*	-

#* Create a list of files without exif info
#! exiftool -r  -if 'not $EXIF:All' -FileName  -ext jpg ./NOEXIF >> ./NotEXIFFILES.txt

#* Create a list of files that have exif info
#! exiftool -r  -if '$EXIF:All' -FileName  -ext jpg ./NOEXIF >> ./HASEXIFFILES.txt

#~ 🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾

#~ ######################################################################################################
-echo
'#~ 🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾'
-echo
'1 - MEDIA - MOVES FILES MISSING EXIF METADATA TO SEPERATE LOCATION'
-echo
'#~ 🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾🅾'
